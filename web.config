<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="CompaniesPortfolio API reverse proxy" stopProcessing="true">
          <match url="^api(?:/(.*))?$" />
          <action type="Rewrite" url="http://127.0.0.1:4317/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="CompaniesPortfolio application routes" stopProcessing="true">
          <match url="^(empresa|company|painel|panel|team|org|investidor|legal|verify-email|reset-password)(/.*)?$" />
          <action type="Rewrite" url="/index.html" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
